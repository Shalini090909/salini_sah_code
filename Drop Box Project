# Initialize the Dropbox client
dbx = dropbox.Dropbox(ACCESS_TOKEN)

def list_files_with_timestamps(folder_path=""):
    """ List files with modification timestamps in a given Dropbox folder. """
    try:
        response = dbx.files_list_folder(folder_path)

        for entry in response.entries:
            if isinstance(entry, dropbox.files.FileMetadata):
                print(f"File: {entry.name}")
                print(f"Client Modified: {entry.client_modified}")
                print(f"Server Modified: {entry.server_modified}")
                print("-" * 40)

    except dropbox.exceptions.ApiError as e:
        print(f"API Error: {e}")

# Call the function for the root folder
